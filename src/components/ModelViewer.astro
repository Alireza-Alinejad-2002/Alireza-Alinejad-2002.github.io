---
// Poster-first 3D viewer. Ships a static <img> poster and a button; <model-viewer> (and three.js)
// are only downloaded when the visitor asks for the model. No JS → the poster still works.
import { statSync } from 'node:fs';
import { join } from 'node:path';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string; // path under /public, e.g. /models/fm13.glb
  poster: ImageMetadata;
  alt: string;
  caption?: string;
  credit?: string;
}
const { src, poster, alt, caption, credit } = Astro.props;
const bytes = statSync(join(process.cwd(), 'public', src)).size;
const size = bytes >= 1e6 ? `${(bytes / 1e6).toFixed(1)} MB` : `${Math.round(bytes / 1e3)} KB`;
---
<figure class="not-prose my-10">
  <div class="model-frame frame relative aspect-[16/10] border border-hairline bg-white" data-model={src} data-alt={alt}>
    <Image
      src={poster}
      alt={alt}
      widths={[640, 960, 1280, 1600]}
      sizes="(min-width: 1024px) 960px, 100vw"
      format="webp"
      quality={90}
      class="model-poster absolute inset-0 size-full object-contain"
      loading="lazy"
      decoding="async"
    />
    <button type="button" class="model-load btn-line absolute bottom-3 left-3 bg-white! text-[#121212]! border-[#121212]/25!" hidden>
      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2 3 7v10l9 5 9-5V7l-9-5Z" /><path d="m3 7 9 5 9-5M12 12v10" /></svg>
      <span class="model-label">Load 3D model · {size}</span>
    </button>
    <p class="model-hint meta absolute right-3 bottom-3 text-[#5E5E5A]!" hidden>Drag to orbit · pinch or scroll to zoom</p>
  </div>
  {(caption || credit) && (
    <figcaption class="meta mt-2 flex flex-col gap-1">
      {caption && <span>{caption}</span>}
      {credit && <span>{credit}</span>}
    </figcaption>
  )}
</figure>

<script>
  let loader: Promise<unknown> | null = null;
  function loadLib() {
    if (!loader) {
      // model-viewer reads this before it defines the element.
      (self as unknown as { ModelViewerElement: object }).ModelViewerElement = {
        meshoptDecoderLocation: '/models/decoders/meshopt.js',
      };
      loader = import('@google/model-viewer');
    }
    return loader;
  }

  document.querySelectorAll<HTMLElement>('.model-frame').forEach((frame) => {
    const btn = frame.querySelector<HTMLButtonElement>('.model-load')!;
    const label = frame.querySelector<HTMLElement>('.model-label')!;
    const hint = frame.querySelector<HTMLElement>('.model-hint')!;
    const poster = frame.querySelector<HTMLImageElement>('.model-poster')!;
    btn.hidden = false;

    btn.addEventListener('click', async () => {
      btn.disabled = true;
      btn.setAttribute('aria-busy', 'true');
      const original = label.textContent;
      label.textContent = 'Loading…';
      try {
        await loadLib();
        const mv = document.createElement('model-viewer') as HTMLElement & { dismissPoster?: () => void };
        mv.setAttribute('src', frame.dataset.model!);
        mv.setAttribute('alt', frame.dataset.alt!);
        mv.setAttribute('camera-controls', '');
        // The click is the consent to download: fetch now, keep our poster until it is ready.
        mv.setAttribute('loading', 'eager');
        mv.setAttribute('reveal', 'manual');
        mv.setAttribute('camera-orbit', '45deg 54.7deg 80%');
        mv.setAttribute('environment-image', 'neutral');
        mv.setAttribute('touch-action', 'pan-y');
        mv.setAttribute('interaction-prompt', 'none');
        mv.setAttribute('shadow-intensity', '0.5');
        mv.setAttribute('shadow-softness', '1');
        mv.setAttribute('exposure', '0.9');
        mv.setAttribute('tone-mapping', 'aces');
        mv.className = 'absolute inset-0 size-full';
        mv.style.setProperty('--poster-color', 'transparent');
        mv.addEventListener(
          'load',
          () => {
            mv.dismissPoster?.();
            poster.style.visibility = 'hidden';
            btn.remove();
            hint.hidden = false;
          },
          { once: true },
        );
        mv.addEventListener(
          'error',
          () => {
            label.textContent = 'Could not load the model';
            mv.remove();
          },
          { once: true },
        );
        frame.appendChild(mv);
      } catch {
        label.textContent = original;
        btn.disabled = false;
      } finally {
        btn.removeAttribute('aria-busy');
      }
    });
  });
</script>
