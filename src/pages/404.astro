---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="wrap py-24 sm:py-32">
    <p class="meta">404</p>
    <h1 class="mt-3 text-title font-medium">This page isn’t here.</h1>
    <p class="mt-4 max-w-[34rem] text-muted">It may have moved when the site was rebuilt. The projects are all on the home page.</p>
    <a href="/" class="btn-ink mt-8">Back to the home page</a>
  </section>
</Base>
